+    }));
+    const normalizedGaps = (r.gaps || []).map((g) => ({
+      ...g,
+      coverage_level: normalizeLevel(g.coverage_level),
+    }));
+    return {
+      ...r,
+      coverage: normalizedCoverage,
+      gaps: normalizedGaps,
